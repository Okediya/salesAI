# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# App Configuration
APP_NAME=SalesAI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./salesai.db

# TaskMaster Autonomous Engine Settings
DEFAULT_AUTONOMY_MODE=AUTOPILOT  # Options: AUTOPILOT, COPILOT
AUTONOMOUS_CYCLE_INTERVAL_SECONDS=30
PROSPECT_BATCH_SIZE=5
CONFIDENCE_THRESHOLD=0.75
ENABLE_GROUNDING=true
